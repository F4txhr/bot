# --- Logging groups (optional) ---
# Group chat ID to receive payment logs (manual & Trakteer)
PAYMENT_LOG_CHAT_ID=0
# Topic/thread ID in that group for payments (0 if not using topics)
PAYMENT_LOG_TOPIC_ID=0

# Group chat ID to receive report logs (can be same as PAYMENT_LOG_CHAT_ID)
REPORT_LOG_CHAT_ID=0
# Topic/thread ID in that group for reports (0 if not using topics)
